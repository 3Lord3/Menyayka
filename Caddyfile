example.com, www.example.com {
	encode gzip

	# Backend liveness (don't serve the SPA from the frontend)
	handle /healthz {
		reverse_proxy backend:8080
	}

	# Item photos from SeaweedFS S3 backend: https://example.com/s3/items/...
	handle_path /s3/* {
		reverse_proxy seaweedfs:9000
	}

	# API same-origin for the frontend with an empty VITE_API_BASE_URL
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Swagger UI + OpenAPI spec (served by the backend)
	handle /swagger/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:80
	}
}
