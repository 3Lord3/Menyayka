# Copy to the VPS: /opt/menyayka/.env
# cp .env.deploy.example .env && nano .env
#
# These must live on the server together with .env:
#   docker-compose.prod.yml, Caddyfile, backend/migrations/
# GitHub Actions copies them; for manual bring-up use rsync/scp.

# --- Postgres ---
DB_USER=menyayka
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=menyayka

# --- App ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
LOG_LEVEL=info
# Gin: forced to GIN_MODE=release in docker-compose.prod.yml.
# Empty = same-origin /api through Caddy (as in prod).
VITE_API_BASE_URL=

# --- Transactional mail (password recovery, exchange confirmations) ---
# Two backends are supported via MAILER_PROVIDER:
#
#   smtp   (default) — RFC 5321 SMTP. Works with any relay (Mailgun, Brevo,
#                       Gmail, your own SMTP, ...).
#   resend — Resend HTTP API (https://resend.com). Use when outbound
#            25/465/587 is blocked (many cloud VPS providers do this).
#
# Fill in only the block for the provider you pick; leave the other empty.

MAILER_PROVIDER=smtp

# SMTP backend (used when MAILER_PROVIDER=smtp).
# SMTP_ENCRYPTION: starttls (port 587) | tls (port 465) | plain (port 25 / local relay).
#
# Example — local plaintext relay running on the host (e.g. a socat that
# forwards IPv4 from mail.ru over IPv6; no TLS termination on the relay):
#   SMTP_HOST=172.18.0.1
#   SMTP_PORT=2525
#   SMTP_ENCRYPTION=plain
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENCRYPTION=starttls

# Resend backend (used when MAILER_PROVIDER=resend). Verify your sending
# domain in the Resend dashboard before going to production.
RESEND_API_KEY=
MAIL_FROM=Menyayka <noreply@example.com>

# --- Host port mapping for Caddy ---
# Default is 80 (TLS terminates at the fronting host proxy, so only one port
# is exposed). Override here if 80 is already taken on the host (e.g. an
# existing nginx / apache). When you change it, update the host-side reverse
# proxy that fronts menyayka.* accordingly.
# CADDY_HTTP_PORT=80

# --- S3-compatible object storage (SeaweedFS) ---
# SeaweedFS in standalone mode accepts any access/secret key pair; the values
# below are used by the backend client to sign requests to the S3 gateway.
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS
S3_SECRET_KEY=CHANGE_ME_S3_SECRET
S3_BUCKET=items
# Public photo URLs: https://<S3_PUBLIC_ENDPOINT>/items/...
S3_PUBLIC_ENDPOINT=example.com/s3
S3_PUBLIC_USE_SSL=true

# --- Embeddings ---
EMBEDDING_PROVIDER=tei
VECTOR_DIM=384
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9

# --- Matching (defaults are fine as-is) ---
MATCHING_THRESHOLD=0.5
CLUSTER_SIMILARITY_THRESHOLD=0.9

# Ranker: ml (default) | formula
RANKER_MODE=ml

# --- Images ---
# CI overwrites these lines with the actual SHA tag on every deploy.
# Don't treat IMAGE_TAG=latest as the "source of truth" for manual compose up —
# otherwise images other than those deployed by Actions come up.
DOCKER_IMAGE_PREFIX=ghcr.io/your-org/menyayka
IMAGE_TAG=latest

# --- Realtime WebSocket ---
WS_ALLOWED_ORIGINS=https://example.com
VITE_REALTIME_ENABLED=true
