# Copy to the VPS: /opt/menyayka/.env
# cp .env.deploy.example .env && nano .env
#
# These must live on the server together with .env:
#   docker-compose.prod.yml, Caddyfile, backend/migrations/
# GitHub Actions copies them; for manual bring-up use rsync/scp.

# --- Postgres ---
DB_USER=menyayka
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=menyayka

# --- App ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
LOG_LEVEL=info
# Gin: forced to GIN_MODE=release in docker-compose.prod.yml.
# Empty = same-origin /api through Caddy (as in prod).
VITE_API_BASE_URL=

# --- SMTP (mail.ru app password) ---
# On the Timeweb VPS outbound SMTP mail.ru is usually blocked over IPv4 but works over IPv6,
# and the Docker network has no IPv6. So a relay runs on the host:
#   systemctl status menyayka-smtp-relay
#   (socat: 172.18.0.1:2525 plaintext -> mail.ru:465 TLS/IPv6)
# Then for the container in .env:
SMTP_HOST=172.18.0.1
SMTP_PORT=2525
SMTP_USERNAME=menyayka_avito@mail.ru
SMTP_PASSWORD=
SMTP_FROM=menyayka_avito@mail.ru
SMTP_ENCRYPTION=plain

# --- MinIO ---
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=items
# Public photo URLs: https://menyayka.tech/s3/items/...
MINIO_PUBLIC_ENDPOINT=menyayka.tech/s3
MINIO_PUBLIC_USE_SSL=true

# --- Embeddings ---
EMBEDDING_PROVIDER=tei
VECTOR_DIM=384
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9

# --- Matching (defaults are fine as-is) ---
MATCHING_THRESHOLD=0.5
CLUSTER_SIMILARITY_THRESHOLD=0.9

# Ranker: ml (default) | formula
RANKER_MODE=ml

# --- Images (overwritten by CI on deploy) ---
# --- Images ---
# CI overwrites these lines with the actual SHA tag on every deploy.
# Don't treat IMAGE_TAG=latest as the "source of truth" for manual compose up —
# otherwise images other than those deployed by Actions come up.
DOCKER_IMAGE_PREFIX=ghcr.io/avito-team-not-found/menyayka
IMAGE_TAG=latest
