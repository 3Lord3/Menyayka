# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=menyayka
DB_PASSWORD=menyayka
DB_NAME=menyayka

# Application
SERVER_PORT=8080
JWT_SECRET=change-me-in-production

# Transactional mail (password recovery, exchange confirmations).
# The server starts fine without these, but the corresponding flows will
# return a send error. We use the Resend HTTP API instead of SMTP because
# cloud VPS providers (e.g. Oracle Cloud) often block outbound 25/465/587.
# Get a key at https://resend.com and verify your sending domain in the
# dashboard before going to production.
RESEND_API_KEY=
MAIL_FROM=Menyayka <noreply@menyayka.lorot.dev>

# Embeddings (TEI)
EMBEDDING_PROVIDER=stub          # stub | tei
TEI_URL=http://tei:80            # in-network address of TEI in the docker network
TEI_EXTERNAL_PORT=8090           # external TEI port on the host
# TEI_IMAGE — image for the tei service. Default uses the x86_64 tag cpu-1.9.
# On Apple Silicon (arm64) it is not pulled (no arm64 manifest), uncomment:
# TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-latest
VECTOR_DIM=384
EMBEDDING_TIMEOUT=2s
MAX_INPUT_LENGTH=1500

MATCHING_TOPK=20                # top-K candidate limit during BFS chain search
MATCHING_THRESHOLD=0.5          # minimum cosine similarity for a want→item edge
VECTOR_METRIC=cosine            # distance metric (cosine, matches the indexes)
CLUSTER_TOPK=50                 # nearest offers during clustering
# "Same direction" (offer+want) threshold. Don't confuse with MATCHING_THRESHOLD:
# too low → opposite-direction swaps get grouped, 2-cycles won't be built.
# For multilingual-e5 on closely related electronics ~0.9 is typical.
CLUSTER_SIMILARITY_THRESHOLD=0.9
CLUSTER_DIRECTION_MARGIN=0.05   # without a category, forward direction must beat reverse by this margin
CYCLE_OUTGOING_K=20             # max neighbours per vertex in the local graph
CYCLE_MAX_DRAFTS=10             # max best cycles returned
CYCLE_MIN_AVERAGE_SCORE=0.85    # minimum average cosine across all cycle edges
CYCLE_MAX_SCORE_GAP=0.20        # max gap between the best and the worst edge

# Ranker: ml (default, fail-fast on model load) | formula (explicit baseline).
RANKER_MODE=ml
RANKER_MODEL_PATH=pkg/utils/ranker/models/ranker_v1.txt

# Full connection string (consumed by the backend)
DATABASE_URL=postgres://menyayka:menyayka@localhost:5432/menyayka?sslmode=disable

# S3-compatible object storage (SeaweedFS).
# The app reaches it inside the docker network at "seaweedfs:9000".
# Public image URLs go through the frontend nginx /s3 proxy:
#   http://localhost:3000/s3/...  (S3_PUBLIC_ENDPOINT is set in compose).
# SeaweedFS in standalone mode accepts any access/secret key pair, so the values
# below are only forwarded to the backend client.
FRONTEND_PORT=3000
S3_PORT=9000
S3_ACCESS_KEY=menyayka_minio
S3_SECRET_KEY=menyayka_minio_secret
S3_BUCKET=items
# In prod behind Caddy: S3_USE_SSL=false (inside the network),
# S3_PUBLIC_USE_SSL=true (browser reaches the proxy over HTTPS).
# S3_PUBLIC_USE_SSL=false

# --- Realtime WebSocket (see REALTIME_WS_PLAN.md) ---
# Comma-separated origin whitelist; empty = fail-closed (browser connections rejected).
# Locally: compose serves the frontend on :3000, Vite dev on :5173.
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
WS_HEARTBEAT=30s          # server ping interval
WS_WRITE_TIMEOUT=10s      # per-event write deadline
WS_TICKET_TTL=30s         # one-time ws ticket TTL
WS_MAX_CONNECTIONS=0      # 0 = unlimited
WS_MAX_CONNS_PER_USER=5
WS_MAX_CHAIN_SUBS=50
WS_SUB_TTL=30m            # idle chain-subscription TTL
WS_MSG_RATE=100           # messages per window; a reconnect replays up to WS_MAX_CHAIN_SUBS subs
WS_MSG_RATE_WINDOW=10s
# ?ticket= query fallback: off by default (the ticket should travel as a subprotocol,
# otherwise it leaks into access logs)
WS_ALLOW_QUERY_TICKET=false
# Frontend: false disables WS and keeps polling (e.g. a test env without WS); the app also
# falls back to fast polling on its own when the socket is down.
VITE_REALTIME_ENABLED=true