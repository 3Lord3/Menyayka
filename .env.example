# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=menyayka
DB_PASSWORD=menyayka
DB_NAME=menyayka

# Application
SERVER_PORT=8080
JWT_SECRET=change-me-in-production

# SMTP (для отправки кода восстановления пароля). Без этих переменных сервер
# запускается нормально, но POST /account/password-recovery/send-code/ упадёт
# с ошибкой отправки письма.
#
# SMTP_ENCRYPTION — режим шифрования соединения, один из:
#   starttls (порт обычно 587) — TCP открытым текстом, потом апгрейд до TLS командой STARTTLS. Дефолт, подходит для Gmail/Yandex/Mail.ru.
#   tls      (порт обычно 465) — TLS с первого байта (implicit TLS), без plaintext-фазы.
#   plain    (порт обычно 25)  — без шифрования вообще; почтовые провайдеры для AUTH это не поддерживают, годится только для доверенных внутренних релеев.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENCRYPTION=starttls

# Embeddings (TEI)
EMBEDDING_PROVIDER=stub          # stub | tei
TEI_URL=http://tei:80            # внутренний адрес TEI в docker-сети
TEI_EXTERNAL_PORT=8090           # внешний порт TEI с хоста
# TEI_IMAGE — образ сервиса tei. По умолчанию используется x86_64-тег cpu-1.9.
# На Apple Silicon (arm64) он не подтягивается (нет arm64-манифеста), раскомментируй:
# TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-latest
VECTOR_DIM=384
EMBEDDING_TIMEOUT=2s
MAX_INPUT_LENGTH=1500

MATCHING_TOPK=20                # лимит лучших кандидатов при BFS-поиске цепочек
MATCHING_THRESHOLD=0.5          # мин. косинусное подобие ребра want→item
VECTOR_METRIC=cosine            # метрика расстояния (cosine, согласовано с индексами)
CLUSTER_TOPK=50                 # ближайшие заявки при кластеризации
# Порог «то же направление» (offer+want). Не путать с MATCHING_THRESHOLD:
# слишком низкий — противоположные свапы в одном кластере, 2-цикл не строится.
# Для multilingual-e5 на близкой электронике обычно нужно ~0.9.
CLUSTER_SIMILARITY_THRESHOLD=0.9
CLUSTER_DIRECTION_MARGIN=0.05   # без категории прямое направление должно быть сильнее обратного
CYCLE_OUTGOING_K=20             # максимум соседей одной вершины локального графа
CYCLE_MAX_DRAFTS=10             # максимум лучших найденных циклов
CYCLE_MIN_AVERAGE_SCORE=0.85    # минимум среднего cosine по всем стрелкам цикла
CYCLE_MAX_SCORE_GAP=0.20        # максимум разницы между лучшей и худшей стрелкой

# Ranker: ml (дефолт, fail-fast на загрузке модели) | formula (явный baseline).
RANKER_MODE=ml
RANKER_MODEL_PATH=pkg/utils/ranker/models/ranker_v1.txt

# Полная строка подключения (для бэкенда)
DATABASE_URL=postgres://menyayka:menyayka@localhost:5432/menyayka?sslmode=disable

# MinIO (хранилище фото товаров). Приложение внутри докер-сети стучится в MinIO по
# внутреннему хосту "minio:9000". В docker-compose.yml публичные image_url идут через
# frontend nginx: http://localhost:3000/s3/... (MINIO_PUBLIC_ENDPOINT задаётся в compose).
FRONTEND_PORT=3000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=menyayka_minio
MINIO_SECRET_KEY=menyayka_minio_secret
MINIO_BUCKET=items
# В проде за Caddy: MINIO_USE_SSL=false (внутри сети), MINIO_PUBLIC_USE_SSL=true
# MINIO_PUBLIC_USE_SSL=false

# --- Realtime WebSocket (see REALTIME_WS_PLAN.md) ---
# Comma-separated origin whitelist; empty = fail-closed (browser connections rejected).
# Locally: compose serves the frontend on :3000, Vite dev on :5173.
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
WS_HEARTBEAT=30s          # server ping interval
WS_WRITE_TIMEOUT=10s      # per-event write deadline
WS_TICKET_TTL=30s         # one-time ws ticket TTL
WS_MAX_CONNECTIONS=0      # 0 = unlimited
WS_MAX_CONNS_PER_USER=5
WS_MAX_CHAIN_SUBS=50
WS_SUB_TTL=30m            # idle chain-subscription TTL
WS_MSG_RATE=100           # messages per window; a reconnect replays up to WS_MAX_CHAIN_SUBS subs
WS_MSG_RATE_WINDOW=10s
# ?ticket= query fallback: off by default (the ticket should travel as a subprotocol,
# otherwise it leaks into access logs)
WS_ALLOW_QUERY_TICKET=false
# Frontend: false disables WS and keeps polling (e.g. a test env without WS); the app also
# falls back to fast polling on its own when the socket is down.
VITE_REALTIME_ENABLED=true
